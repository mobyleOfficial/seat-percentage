{
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "ingresso-seat-percentage@mobyleofficial.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "name": "Ingresso Seat Percentage",
  "version": "1.0.0",
  "description": "Mostra a ocupação da sala acima de cada horário de sessão no ingresso.com",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.ingresso.com/filme/*", "https://www.ingresso.com/cinema/*"],
      "js": ["lib/seat-percentage.js", "inpage.js"],
      "css": ["inpage.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
